{
  "manifest_version": 2,
  "name": "Export ZIP",
  "version": "1.0.1",
  "description": "Save the open page, its current form state, and its source assets for offline inspection.",
  "permissions": ["activeTab", "http://*/*", "https://*/*"],
  "browser_action": {
    "default_title": "Export ZIP",
    "default_icon": "icon.svg"
  },
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "background": {"scripts": ["background.js"]},
  "browser_specific_settings": {
    "gecko": {
      "id": "export-zip@offline-inspection.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["none"]}
    },
    "gecko_android": {"strict_min_version": "142.0"}
  }
}
